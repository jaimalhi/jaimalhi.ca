{
	"name": "jaimalhi.ca",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate:deps": "node scripts/validate-dependencies.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"cookie": "0.7.2",
		"postcss-selector-parser": "7.1.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "6.3.2",
		"@sveltejs/kit": "2.69.1",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@types/eslint": "9.6.1",
		"autoprefixer": "10.4.23",
		"daisyui": "4.12.24",
		"eslint": "9.39.2",
		"eslint-config-prettier": "9.1.2",
		"eslint-plugin-svelte": "2.46.1",
		"globals": "15.15.0",
		"postcss": "8.5.23",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.1",
		"svelte": "5.56.1",
		"svelte-check": "4.3.5",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"typescript-eslint": "8.52.0",
		"vite": "7.3.7"
	},
	"type": "module"
}
